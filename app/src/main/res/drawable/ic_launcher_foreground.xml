                </gradient>
            </aapt:attr>
        </path>

        <!-- Shading of the rising band below the valley (fades out toward the arrow). -->
        <path android:pathData="M609,654 C652,684 716,686 760,650 L946,480 L946,474 L887,414 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="linear"
                    android:startX="650"
                    android:startY="660"
                    android:endX="890"
                    android:endY="430">
                    <item android:offset="0" android:color="#990A5F5E" />
                    <item android:offset="1" android:color="#000A5F5E" />
                </gradient>
            </aapt:attr>
