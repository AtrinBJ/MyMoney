<?xml version="1.0" encoding="utf-8"?>
<!-- Financial data never leaves the device through Android cloud backup or device transfer.
     The database key lives in the Keystore and cannot be restored elsewhere anyway; users back up
     with the app's own .mmbak format instead (docs/BACKUP_RESTORE.md). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
