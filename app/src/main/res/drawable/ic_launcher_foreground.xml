                    android:type="linear"
                    android:startX="1010"
                    android:startY="350"
                    android:endX="360"
                    android:endY="950">
                    <item android:offset="0" android:color="#FF3EDE99" />
                    <item android:offset="0.45" android:color="#FF1AA586" />
                    <item android:offset="1" android:color="#FF0B5F62" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- Fold shading where the ribbon passes over the left leg (inside the silhouette). -->
        <path android:pathData="M437,632 C398,598 345,668 302,772 L302,846 C302,906 349,955 404,955 C423,955 437,942 437,920 Z">
            <aapt:attr name="android:fillColor">
