    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:scaleX="0.0672"
        android:scaleY="0.0672"
        android:translateX="9.72"
        android:translateY="10.39">

        <!-- Left leg, falling ribbon, rising band and arrow head (one continuous stroke of the M). -->
        <path android:pathData="M302,565 C302,525 335,495 380,495 C400,495 418,502 433,513 L609,654 L887,414 L818,414 L786,382 C775,371 776,352 792,345 C797,343 802,343 808,343 L995,343 Q1016,343 1016,364 L1016,568 Q1016,590 995,590 Q988,590 983,585 L946,551 L946,480 L640,748 Q624,760 610,760 Q596,760 584,751 L437,632 L437,920 C437,942 423,955 404,955 C349,955 302,906 302,846 Z">
            <aapt:attr name="android:fillColor">
